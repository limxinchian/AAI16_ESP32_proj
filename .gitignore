# Python environment, build output, generated files
.venv/
__pycache__/
build/
build_*/
managed_components/
tests/*/_gen/
tools/_gen/
tools/qemu/
tests/qemu_nvs_probe/build/

# Local ESP-IDF configuration: holds the Wi-Fi SSID/password entered with `idf.py menuconfig`. NEVER commit.
sdkconfig
sdkconfig.old
tests/qemu_nvs_probe/sdkconfig
tests/qemu_nvs_probe/sdkconfig.old

# Editor settings with local paths; third-party reference code that must not be redistributed
.vscode/
FlexiEdgePico-main/
*.zip

# Sensor recordings: only the small anomaly-model recordings are kept
data/*
!data/anomaly/

# Demo tool state (transfer ids of the last upload) and optional recordings
demo/.state.json
demo/upload_run.csv

# ESP32-S3-N16R8: 16 MB quad flash + 8 MB octal PSRAM (module-integrated; nothing to wire).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# 1 ms scheduler tick: sensors run at up to 50 Hz
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The node core is allocated explicitly in PSRAM (heap_caps_calloc); keep large malloc() in PSRAM too
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# MQTT messages up to the ConfigApply maximum are handled by the node; broker-side limits still apply
CONFIG_MQTT_REPORT_DELETED_MESSAGES=y

# Store text with LF line endings in the repository, whatever the contributor's OS.
* text=auto eol=lf

# Windows scripts keep CRLF in the working tree.
*.ps1 text eol=crlf

# Binary artifacts: never touch line endings or diff them as text.
*.amdl     binary
*.tflite   binary
*.bin      binary
*.pdf      binary
*.png      binary
*.jpg      binary
